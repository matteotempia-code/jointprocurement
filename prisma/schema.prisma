generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BudgetStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum RequisitionStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CLARIFICATION_REQUESTED
  CANCELLED
}

enum PolicyOutcome {
  AUTO_APPROVE
  AREA_MANAGER_APPROVAL
  PROCUREMENT_APPROVAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CLARIFICATION_REQUESTED
  CANCELLED
}

enum PurchaseOrderStatus {
  ISSUED
  ACKNOWLEDGED
  PARTIALLY_RECEIVED
  RECEIVED
  ISSUE
  CANCELLED
}

enum ReceiptStatus {
  COMPLETE
  PARTIAL
  WITH_ISSUES
}

enum IssueType {
  MISSING
  DAMAGED
  WRONG_ITEM
  QUALITY
  EXPIRY
  PACKAGING
  LATE_DELIVERY
  OTHER
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum OutOfCatalogStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CONVERTED
}

enum OperationalAttachmentKind {
  OUT_OF_CATALOG
  RECEIPT
  QUALITY_ISSUE
}

enum ProcurementLimitType {
  MONETARY
  QUANTITY
}

enum AvailabilityStatus {
  IN_STOCK
  LIMITED
  BACKORDER
  UNAVAILABLE
}

enum SourceDocumentStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  REQUIRES_PROVIDER
  FAILED
}

enum ImportJobStatus {
  UPLOADED
  PARSING
  PARSED
  INTERPRETING
  INTERPRETED
  NEEDS_REVIEW
  READY_TO_PUBLISH
  PUBLISHING
  PUBLISHED
  REQUIRES_PROVIDER
  FAILED
}

enum ImportDocumentKind {
  PRICE_LIST
  OFFER
  QUOTATION
  INFORMATIONAL_INVOICE
  OTHER
}

enum ImportRecordStatus {
  READY
  NEEDS_REVIEW
  CONFIRMED
  NEW_PRODUCT_CONFIRMED
  NON_COMPARABLE
  IGNORED
  PUBLISHED
  FAILED
}

enum ProductMatchType {
  IDENTICAL
  PROBABLE_MATCH
  COMMERCIAL_SUBSTITUTE
  FUNCTIONAL_EQUIVALENT
  NEW_PRODUCT
}

enum MatchHumanDecision {
  PENDING
  ACCEPTED
  REJECTED
  CREATE_NEW
  NOT_COMPARABLE
}

model Organization {
  id              String                @id @default(cuid())
  name            String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  legalEntities   LegalEntity[]
  users           UserAssignment[]
  budgets         Budget[]
  requisitions    PurchaseRequisition[]
  purchaseOrders  PurchaseOrder[]
  sourceDocuments SourceDocument[]
  operationalAttachments OperationalAttachment[]
  procurementLimits ProcurementLimit[]
  procurementMemories ProcurementMemory[]
  procurementAICalls ProcurementAICall[]
}

model LegalEntity {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  areas          Area[]
  budgets        Budget[]
}

model Area {
  id            String      @id @default(cuid())
  name          String
  legalEntityId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  facilities    Facility[]
  budgets       Budget[]
}

model Facility {
  id             String                @id @default(cuid())
  name           String
  address        String?
  areaId         String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  area           Area                  @relation(fields: [areaId], references: [id], onDelete: Cascade)
  costCenters    CostCenter[]
  budgets        Budget[]
  carts          Cart[]
  requisitions   PurchaseRequisition[]
  purchaseOrders PurchaseOrder[]
  receipts       Receipt[]
  procurementLimits ProcurementLimit[]
  operationalAttachments OperationalAttachment[]
}

model CostCenter {
  id           String                @id @default(cuid())
  code         String
  name         String
  facilityId   String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  facility     Facility              @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  budgets      Budget[]
  requisitions PurchaseRequisition[]
  procurementLimits ProcurementLimit[]

  @@unique([facilityId, code])
}

model User {
  id                    String                  @id @default(cuid())
  email                 String                  @unique
  name                  String
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  assignments           UserAssignment[]
  carts                 Cart[]
  requisitions          PurchaseRequisition[]
  approvals             ApprovalRequest[]
  receipts              Receipt[]
  auditEvents           AuditEvent[]
  favorites             Favorite[]
  shoppingLists         ShoppingList[]
  outOfCatalogRequests  OutOfCatalogRequest[]
  delegationsGiven      ApprovalDelegation[]    @relation("Delegator")
  delegationsReceived   ApprovalDelegation[]    @relation("Delegate")
  uploadedDocuments     SourceDocument[]        @relation("DocumentUploader")
  importJobsCreated     ImportJob[]             @relation("ImportJobCreator")
  importCorrections     ImportFieldCorrection[]
  confirmedImportFields ImportedFieldValue[]    @relation("ImportFieldConfirmer")
  publishedPriceLists   PriceList[]             @relation("PriceListPublisher")
  operationalAttachments OperationalAttachment[] @relation("OperationalAttachmentUploader")
  confirmedPriceListConditions PriceListCommercialCondition[] @relation("PriceListConditionConfirmer")
  confirmedProcurementMemories ProcurementMemory[] @relation("ProcurementMemoryConfirmer")
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  assignments UserAssignment[]
}

model UserAssignment {
  id               String            @id @default(cuid())
  userId           String
  roleId           String
  organizationId   String
  scopeType        String
  scopeId          String?
  approvalLimit    Decimal?          @db.Decimal(14, 2)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvalRequests ApprovalRequest[]

  @@index([userId])
  @@index([organizationId])
}

model Supplier {
  id                     String           @id @default(cuid())
  name                   String
  vatNumber              String?          @unique
  contactEmail           String?
  contactPhone           String?
  address                String?
  paymentTerms           String?
  deliveryTerms          String?
  minimumOrderValue      Decimal?         @db.Decimal(14, 2)
  freeShippingThreshold  Decimal?         @db.Decimal(14, 2)
  shippingFeeBelowThreshold Decimal?      @db.Decimal(14, 2)
  surchargeBelowMinimum Decimal?          @db.Decimal(14, 2)
  currency               String           @default("EUR")
  commercialContact      Json?
  orderContact           Json?
  qualityContact         Json?
  certificationPath      String?
  commercialDocumentPath String?
  qualityDocumentPath    String?
  active                 Boolean          @default(true)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  priceLists             PriceList[]
  offers                 SupplierOffer[]
  purchaseOrders         PurchaseOrder[]
  sourceDocuments        SourceDocument[]
  procurementMemories    ProcurementMemory[]
}

model Category {
  id        String             @id @default(cuid())
  name      String
  code      String             @unique
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  products  CanonicalProduct[]
  budgets   Budget[]
  procurementLimits ProcurementLimit[]
}

model CanonicalProduct {
  id                    String                    @id @default(cuid())
  name                  String
  description           String?
  shortDescription      String?
  longDescription       String?
  brand                 String?
  manufacturer          String?
  manufacturerSku       String?
  ean                   String?
  uom                   String
  purchaseUom           String                    @default("PACK")
  unitsPerPackage       Decimal?                  @db.Decimal(14, 4)
  consumptionUom        String?
  consumptionUomLabel   String?
  categoryId            String
  subcategory           String?
  packageDescription    String?
  technicalAttributes   Json?
  imagePath             String?
  datasheetPath         String?
  safetySheetPath       String?
  certificationPath     String?
  declarationPath       String?
  active                Boolean                   @default(true)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  category              Category                  @relation(fields: [categoryId], references: [id])
  offers                SupplierOffer[]
  cartLines             CartLine[]
  requisitionLines      PurchaseRequisitionLine[]
  orderLines            PurchaseOrderLine[]
  favorites             Favorite[]
  shoppingListItems     ShoppingListItem[]
  importMatchCandidates ProductMatchCandidate[]
  importedRecords       ImportedRecord[]
  procurementLimits     ProcurementLimit[]

  @@index([ean])
  @@index([categoryId, subcategory])
}

model PriceList {
  id                String          @id @default(cuid())
  name              String
  supplierId        String
  validFrom         DateTime?
  validUntil        DateTime?
  active            Boolean         @default(false)
  sourceFile        String?
  version           Int             @default(1)
  previousVersionId String?
  sourceDocumentId  String?
  importJobId       String?         @unique
  publishedByUserId String?
  publishedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  supplier          Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  offers            SupplierOffer[]
  previousVersion   PriceList?      @relation("PriceListVersions", fields: [previousVersionId], references: [id])
  nextVersions      PriceList[]     @relation("PriceListVersions")
  sourceDocument    SourceDocument? @relation(fields: [sourceDocumentId], references: [id])
  importJob         ImportJob?      @relation(fields: [importJobId], references: [id])
  publishedBy       User?           @relation("PriceListPublisher", fields: [publishedByUserId], references: [id])
  commercialConditions PriceListCommercialCondition[]

  @@index([supplierId, version])
  @@index([sourceDocumentId])
}

model PriceListCommercialCondition {
  id String @id @default(cuid())
  priceListId String
  conditionType String
  numericValue Decimal? @db.Decimal(14, 4)
  textValue String?
  currency String?
  sourceEvidence String
  reasoningSummary String?
  confidence Decimal @db.Decimal(5, 4)
  interpretationProvider String
  providerModel String?
  humanConfirmationState String @default("PENDING")
  confirmedByUserId String?
  confirmedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  confirmedBy User? @relation("PriceListConditionConfirmer", fields: [confirmedByUserId], references: [id])

  @@unique([priceListId, conditionType, sourceEvidence])
  @@index([priceListId, humanConfirmationState])
}

model ProcurementMemory {
  id String @id @default(cuid())
  organizationId String
  supplierId String?
  memoryType String
  lookupKey String
  canonicalValue Json
  sourceEntityId String?
  confirmedByUserId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  confirmedBy User @relation("ProcurementMemoryConfirmer", fields: [confirmedByUserId], references: [id])

  @@unique([organizationId, supplierId, memoryType, lookupKey])
  @@index([organizationId, memoryType])
}

model ProcurementAICall {
  id String @id @default(cuid())
  organizationId String
  importJobId String?
  provider String
  model String
  operation String
  latencyMs Int
  inputTokens Int?
  outputTokens Int?
  totalTokens Int?
  estimatedCostUsd Decimal? @db.Decimal(12, 6)
  resultState String
  errorCode String?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  importJob ImportJob? @relation(fields: [importJobId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([importJobId, operation])
}

model SupplierOffer {
  id                  String                    @id @default(cuid())
  supplierId          String
  canonicalProductId  String
  priceListId         String
  supplierSku         String?
  packageSize         Decimal?                  @db.Decimal(14, 4)
  packageUnit         String?
  unitPrice           Decimal                   @db.Decimal(14, 4)
  normalizedUnitPrice Decimal?                  @db.Decimal(14, 6)
  currency            String                    @default("EUR")
  moq                 Decimal                   @default(1) @db.Decimal(14, 4)
  leadTimeDays        Int                       @default(3)
  taxRate             Decimal                   @default(22) @db.Decimal(5, 2)
  validFrom           DateTime?
  validUntil          DateTime?
  preferred           Boolean                   @default(false)
  active              Boolean                   @default(true)
  availabilityStatus  AvailabilityStatus        @default(IN_STOCK)
  contractReference   String?
  sourceDocumentId    String?
  importedRecordId    String?                   @unique
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  supplier            Supplier                  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  canonicalProduct    CanonicalProduct          @relation(fields: [canonicalProductId], references: [id], onDelete: Cascade)
  priceList           PriceList                 @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  cartLines           CartLine[]
  requisitionLines    PurchaseRequisitionLine[]
  priceHistory        OfferPriceHistory[]
  sourceDocument      SourceDocument?           @relation(fields: [sourceDocumentId], references: [id])
  importedRecord      ImportedRecord?           @relation(fields: [importedRecordId], references: [id])

  @@index([canonicalProductId])
  @@index([supplierId])
  @@index([sourceDocumentId])
}

model OfferPriceHistory {
  id              String        @id @default(cuid())
  supplierOfferId String
  price           Decimal       @db.Decimal(14, 4)
  normalizedPrice Decimal       @db.Decimal(14, 6)
  effectiveAt     DateTime
  createdAt       DateTime      @default(now())
  supplierOffer   SupplierOffer @relation(fields: [supplierOfferId], references: [id], onDelete: Cascade)

  @@index([supplierOfferId, effectiveAt])
}

model Budget {
  id             String       @id @default(cuid())
  organizationId String
  legalEntityId  String?
  areaId         String?
  facilityId     String?
  costCenterId   String?
  categoryId     String?
  periodStart    DateTime
  periodEnd      DateTime
  approvedAmount Decimal      @db.Decimal(14, 2)
  actualAmount   Decimal      @default(0) @db.Decimal(14, 2)
  status         BudgetStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legalEntity    LegalEntity? @relation(fields: [legalEntityId], references: [id])
  area           Area?        @relation(fields: [areaId], references: [id])
  facility       Facility?    @relation(fields: [facilityId], references: [id])
  costCenter     CostCenter?  @relation(fields: [costCenterId], references: [id])
  category       Category?    @relation(fields: [categoryId], references: [id])

  @@index([organizationId, periodStart, periodEnd])
  @@index([facilityId, categoryId])
}

model ProcurementLimit {
  id                 String               @id @default(cuid())
  organizationId     String
  facilityId         String
  canonicalProductId String?
  categoryId         String?
  costCenterId       String?
  limitType          ProcurementLimitType
  periodStart        DateTime
  periodEnd          DateTime
  maximumAmount      Decimal?             @db.Decimal(14, 2)
  maximumQuantity    Decimal?             @db.Decimal(14, 4)
  quantityUom        String?
  active             Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facility           Facility             @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  canonicalProduct   CanonicalProduct?     @relation(fields: [canonicalProductId], references: [id], onDelete: Restrict)
  category           Category?             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  costCenter         CostCenter?           @relation(fields: [costCenterId], references: [id])

  @@index([facilityId, periodStart, periodEnd])
  @@index([canonicalProductId, active])
  @@index([categoryId, active])
}

model Cart {
  id         String     @id @default(cuid())
  userId     String
  facilityId String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility   Facility   @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  lines      CartLine[]

  @@unique([userId, facilityId])
}

model CartLine {
  id                 String           @id @default(cuid())
  cartId             String
  canonicalProductId String
  supplierOfferId    String
  quantity           Decimal          @db.Decimal(14, 4)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  cart               Cart             @relation(fields: [cartId], references: [id], onDelete: Cascade)
  canonicalProduct   CanonicalProduct @relation(fields: [canonicalProductId], references: [id])
  supplierOffer      SupplierOffer    @relation(fields: [supplierOfferId], references: [id])

  @@unique([cartId, supplierOfferId])
}

model PurchaseRequisition {
  id                String                    @id @default(cuid())
  requisitionNumber String                    @unique
  requesterId       String
  organizationId    String
  facilityId        String
  costCenterId      String
  status            RequisitionStatus         @default(DRAFT)
  subtotal          Decimal                   @db.Decimal(14, 2)
  taxTotal          Decimal                   @db.Decimal(14, 2)
  total             Decimal                   @db.Decimal(14, 2)
  justification     String?
  requiredByDate    DateTime?
  policyDecision    PolicyOutcome
  policyExplanation String
  policyEvaluation  Json
  budgetBefore      Decimal                   @db.Decimal(14, 2)
  budgetAfter       Decimal                   @db.Decimal(14, 2)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  submittedAt       DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  requester         User                      @relation(fields: [requesterId], references: [id])
  organization      Organization              @relation(fields: [organizationId], references: [id])
  facility          Facility                  @relation(fields: [facilityId], references: [id])
  costCenter        CostCenter                @relation(fields: [costCenterId], references: [id])
  lines             PurchaseRequisitionLine[]
  approvals         ApprovalRequest[]
  purchaseOrders    PurchaseOrder[]

  @@index([facilityId, createdAt])
  @@index([status])
}

model PurchaseRequisitionLine {
  id                  String              @id @default(cuid())
  requisitionId       String
  canonicalProductId  String
  supplierOfferId     String
  descriptionSnapshot String
  supplierSnapshot    String
  supplierSkuSnapshot String?
  quantity            Decimal             @db.Decimal(14, 4)
  unitPrice           Decimal             @db.Decimal(14, 4)
  normalizedUnitPrice Decimal?            @db.Decimal(14, 6)
  taxRate             Decimal             @db.Decimal(5, 2)
  lineTotal           Decimal             @db.Decimal(14, 2)
  requisition         PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  canonicalProduct    CanonicalProduct    @relation(fields: [canonicalProductId], references: [id])
  supplierOffer       SupplierOffer       @relation(fields: [supplierOfferId], references: [id])

  @@index([requisitionId])
}

model ApprovalRequest {
  id                   String              @id @default(cuid())
  requisitionId        String
  approverUserId       String
  approverAssignmentId String
  status               ApprovalStatus      @default(PENDING)
  level                Int
  reason               String
  decisionNote         String?
  requestedAt          DateTime            @default(now())
  decidedAt            DateTime?
  delegationId         String?
  requisition          PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  approver             User                @relation(fields: [approverUserId], references: [id])
  approverAssignment   UserAssignment      @relation(fields: [approverAssignmentId], references: [id])

  @@index([approverUserId, status])
}

model PurchaseOrder {
  id                     String              @id @default(cuid())
  poNumber               String              @unique
  requisitionId          String
  supplierId             String
  organizationId         String
  facilityId             String
  deliveryLocation       String
  status                 PurchaseOrderStatus @default(ISSUED)
  subtotal               Decimal             @db.Decimal(14, 2)
  taxTotal               Decimal             @db.Decimal(14, 2)
  total                  Decimal             @db.Decimal(14, 2)
  shippingFee            Decimal             @default(0) @db.Decimal(14, 2)
  commercialPolicy       Json?
  commercialOverrideReason String?
  issuedAt               DateTime
  expectedDeliveryDate   DateTime
  supplierAcknowledgedAt DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  requisition            PurchaseRequisition @relation(fields: [requisitionId], references: [id])
  supplier               Supplier            @relation(fields: [supplierId], references: [id])
  organization           Organization        @relation(fields: [organizationId], references: [id])
  facility               Facility            @relation(fields: [facilityId], references: [id])
  lines                  PurchaseOrderLine[]
  receipts               Receipt[]

  @@index([facilityId, status])
  @@index([supplierId, issuedAt])
}

model PurchaseOrderLine {
  id                  String           @id @default(cuid())
  purchaseOrderId     String
  canonicalProductId  String
  descriptionSnapshot String
  supplierSkuSnapshot String?
  quantity            Decimal          @db.Decimal(14, 4)
  unitPrice           Decimal          @db.Decimal(14, 4)
  taxRate             Decimal          @db.Decimal(5, 2)
  lineTotal           Decimal          @db.Decimal(14, 2)
  purchaseOrder       PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  canonicalProduct    CanonicalProduct @relation(fields: [canonicalProductId], references: [id])
  receiptLines        ReceiptLine[]
  qualityIssues       QualityIssue[]
}

model Receipt {
  id              String        @id @default(cuid())
  receiptNumber   String        @unique
  purchaseOrderId String
  facilityId      String
  receivedById    String
  receivedAt      DateTime      @default(now())
  status          ReceiptStatus
  notes           String?
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  facility        Facility      @relation(fields: [facilityId], references: [id])
  receivedBy      User          @relation(fields: [receivedById], references: [id])
  lines           ReceiptLine[]
  attachments     OperationalAttachment[]
}

model ReceiptLine {
  id                  String            @id @default(cuid())
  receiptId           String
  purchaseOrderLineId String
  quantityOrdered     Decimal           @db.Decimal(14, 4)
  quantityReceived    Decimal           @db.Decimal(14, 4)
  quantityAccepted    Decimal           @db.Decimal(14, 4)
  quantityRejected    Decimal           @db.Decimal(14, 4)
  receipt             Receipt           @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  qualityIssues       QualityIssue[]
}

model QualityIssue {
  id                  String            @id @default(cuid())
  receiptLineId       String?
  purchaseOrderLineId String
  issueType           IssueType
  severity            IssueSeverity     @default(MEDIUM)
  affectedQuantity    Decimal           @db.Decimal(14, 4)
  description         String
  attachmentPath      String?
  status              IssueStatus       @default(OPEN)
  openedAt            DateTime          @default(now())
  resolvedAt          DateTime?
  resolutionType      String?
  resolutionNote      String?
  receiptLine         ReceiptLine?      @relation(fields: [receiptLineId], references: [id])
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  attachments         OperationalAttachment[]

  @@index([status, openedAt])
}

model Favorite {
  id                 String           @id @default(cuid())
  userId             String
  facilityId         String
  canonicalProductId String
  createdAt          DateTime         @default(now())
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  canonicalProduct   CanonicalProduct @relation(fields: [canonicalProductId], references: [id], onDelete: Cascade)

  @@unique([userId, facilityId, canonicalProductId])
  @@index([facilityId])
}

model ShoppingList {
  id          String             @id @default(cuid())
  userId      String
  facilityId  String
  name        String
  description String?
  lastUsedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       ShoppingListItem[]

  @@index([userId, facilityId])
}

model ShoppingListItem {
  id                 String           @id @default(cuid())
  shoppingListId     String
  canonicalProductId String
  quantity           Decimal          @db.Decimal(14, 4)
  position           Int              @default(0)
  shoppingList       ShoppingList     @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  canonicalProduct   CanonicalProduct @relation(fields: [canonicalProductId], references: [id])

  @@unique([shoppingListId, canonicalProductId])
}

model ApprovalDelegation {
  id             String   @id @default(cuid())
  delegatorId    String
  delegateId     String
  organizationId String
  scopeType      String
  scopeId        String?
  categoryId     String?
  approvalLimit  Decimal? @db.Decimal(14, 2)
  validFrom      DateTime
  validUntil     DateTime
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  delegator      User     @relation("Delegator", fields: [delegatorId], references: [id])
  delegate       User     @relation("Delegate", fields: [delegateId], references: [id])

  @@index([delegateId, validFrom, validUntil])
}

model OutOfCatalogRequest {
  id                String             @id @default(cuid())
  requestNumber     String             @unique
  requesterId       String
  organizationId    String
  facilityId        String
  categoryId        String?
  needDescription   String
  quantity          Decimal            @db.Decimal(14, 4)
  estimatedAmount   Decimal?           @db.Decimal(14, 2)
  suggestedSupplier String?
  justification     String
  attachmentPath    String?
  status            OutOfCatalogStatus @default(SUBMITTED)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  requester         User               @relation(fields: [requesterId], references: [id])
  attachments       OperationalAttachment[]

  @@index([organizationId, status])
  @@index([facilityId, createdAt])
}

model OperationalAttachment {
  id                    String                    @id @default(cuid())
  organizationId        String
  facilityId            String
  uploadedByUserId      String
  kind                  OperationalAttachmentKind
  outOfCatalogRequestId String?
  receiptId             String?
  qualityIssueId        String?
  originalFilename      String
  mimeType              String
  sizeBytes             Int
  checksum              String
  storageProvider       String
  storageBucket         String?
  storageObjectKey      String
  immutableAt           DateTime?
  createdAt             DateTime                  @default(now())
  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facility              Facility                  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  uploadedBy            User                      @relation("OperationalAttachmentUploader", fields: [uploadedByUserId], references: [id])
  outOfCatalogRequest   OutOfCatalogRequest?      @relation(fields: [outOfCatalogRequestId], references: [id], onDelete: Cascade)
  receipt               Receipt?                  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  qualityIssue          QualityIssue?             @relation(fields: [qualityIssueId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([outOfCatalogRequestId])
  @@index([receiptId])
  @@index([qualityIssueId])
}

model SourceDocument {
  id               String               @id @default(cuid())
  organizationId   String
  supplierId       String?
  uploadedByUserId String
  originalFilename String
  mimeType         String
  fileSize         Int
  checksum         String
  sourceType       String
  documentKind     ImportDocumentKind
  storagePath      String
  storageProvider  String               @default("local")
  storageBucket    String?
  storageObjectKey String?
  visibility       String               @default("ORGANIZATION_PRIVATE")
  status           SourceDocumentStatus @default(UPLOADED)
  metadata         Json?
  version          Int                  @default(1)
  uploadedAt       DateTime             @default(now())
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier         Supplier?            @relation(fields: [supplierId], references: [id])
  uploadedBy       User                 @relation("DocumentUploader", fields: [uploadedByUserId], references: [id])
  importJobs       ImportJob[]
  priceLists       PriceList[]
  offers           SupplierOffer[]

  @@index([organizationId, uploadedAt])
  @@index([organizationId, storageProvider])
  @@index([checksum])
}

model ImportJob {
  id                     String           @id @default(cuid())
  sourceDocumentId       String
  status                 ImportJobStatus  @default(UPLOADED)
  parserType             String?
  interpretationProvider String           @default("LOCAL_HEURISTIC")
  providerModel          String?
  providerCapabilities   Json?
  interpretationSchema   String           @default("smart-import-v1")
  externalProcessing     Boolean          @default(false)
  startedAt              DateTime?
  completedAt            DateTime?
  failedAt               DateTime?
  errorMessage           String?
  totalRecords           Int              @default(0)
  interpretedRecords     Int              @default(0)
  reviewRequiredRecords  Int              @default(0)
  publishableRecords     Int              @default(0)
  publishedRecords       Int              @default(0)
  columnMapping          Json?
  detectedSheets         Json?
  summary                Json?
  createdByUserId        String
  version                Int              @default(1)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  sourceDocument         SourceDocument   @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  createdBy              User             @relation("ImportJobCreator", fields: [createdByUserId], references: [id])
  records                ImportedRecord[]
  publishedPriceList     PriceList?
  procurementAICalls     ProcurementAICall[]

  @@unique([sourceDocumentId, version])
  @@index([status, createdAt])
  @@index([sourceDocumentId, status])
}

model ImportedRecord {
  id                         String                  @id @default(cuid())
  importJobId                String
  recordIndex                Int
  rawSource                  String
  rawFields                  Json
  interpretedFields          Json
  normalizedFields           Json
  sourceLocator              Json
  searchText                 String                  @default("")
  supplierSkuText            String?
  eanText                    String?
  normalizedPriceValue       Decimal?                @db.Decimal(18, 6)
  exceptionType              String?
  previousNormalizedPrice    Decimal?                @db.Decimal(18, 6)
  previousPackageSize        Decimal?                @db.Decimal(14, 4)
  priceDeltaAmount           Decimal?                @db.Decimal(18, 6)
  priceDeltaPercent          Decimal?                @db.Decimal(12, 4)
  changeType                 String?
  bestCurrentNormalizedPrice Decimal?                @db.Decimal(18, 6)
  extractionConfidence       Decimal?                @db.Decimal(5, 4)
  mappingConfidence          Decimal?                @db.Decimal(5, 4)
  normalizationConfidence    Decimal?                @db.Decimal(5, 4)
  matchConfidence            Decimal?                @db.Decimal(5, 4)
  status                     ImportRecordStatus      @default(NEEDS_REVIEW)
  requiresReview             Boolean                 @default(true)
  validationErrors           Json?
  warnings                   Json?
  humanOverride              Json?
  canonicalProductId         String?
  publishedAt                DateTime?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  importJob                  ImportJob               @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  canonicalProduct           CanonicalProduct?       @relation(fields: [canonicalProductId], references: [id])
  matchCandidates            ProductMatchCandidate[]
  corrections                ImportFieldCorrection[]
  fieldValues                ImportedFieldValue[]
  publishedOffer             SupplierOffer?

  @@unique([importJobId, recordIndex])
  @@index([importJobId, status, recordIndex])
  @@index([importJobId, exceptionType])
  @@index([importJobId, matchConfidence])
  @@index([importJobId, changeType, priceDeltaPercent])
}

model ImportedFieldValue {
  id                      String         @id @default(cuid())
  importedRecordId        String
  fieldName               String
  rawValue                Json?
  interpretedValue        Json?
  normalizedValue         Json?
  humanValue              Json?
  sourceLocator           Json
  extractionConfidence    Decimal?       @db.Decimal(5, 4)
  mappingConfidence       Decimal?       @db.Decimal(5, 4)
  normalizationConfidence Decimal?       @db.Decimal(5, 4)
  interpretationProvider  String?
  providerModel           String?
  schemaVersion           String?
  interpretedAt           DateTime?
  confirmedByUserId       String?
  confirmedAt             DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  importedRecord          ImportedRecord @relation(fields: [importedRecordId], references: [id], onDelete: Cascade)
  confirmedBy             User?          @relation("ImportFieldConfirmer", fields: [confirmedByUserId], references: [id])

  @@unique([importedRecordId, fieldName])
  @@index([importedRecordId])
}

model ProductMatchCandidate {
  id                     String             @id @default(cuid())
  importedRecordId       String
  canonicalProductId     String?
  matchType              ProductMatchType
  score                  Decimal            @db.Decimal(5, 4)
  reasons                Json
  identifierMatches      Json?
  descriptionSimilarity  Decimal?
  uomCompatibility       Boolean?
  packagingCompatibility Boolean?
  categoryCompatibility  Boolean?
  recommended            Boolean            @default(false)
  humanDecision          MatchHumanDecision @default(PENDING)
  decidedByUserId        String?
  decidedAt              DateTime?
  createdAt              DateTime           @default(now())
  importedRecord         ImportedRecord     @relation(fields: [importedRecordId], references: [id], onDelete: Cascade)
  canonicalProduct       CanonicalProduct?  @relation(fields: [canonicalProductId], references: [id])

  @@index([importedRecordId, recommended])
}

model ImportFieldCorrection {
  id                String         @id @default(cuid())
  importedRecordId  String
  fieldName         String
  originalValue     Json?
  interpretedValue  Json?
  correctedValue    Json
  correctedByUserId String
  correctedAt       DateTime       @default(now())
  importedRecord    ImportedRecord @relation(fields: [importedRecordId], references: [id], onDelete: Cascade)
  correctedBy       User           @relation(fields: [correctedByUserId], references: [id])

  @@index([importedRecordId, correctedAt])
}

model AuditEvent {
  id            String   @id @default(cuid())
  actorUserId   String?
  entityType    String
  entityId      String
  action        String
  previousValue Json?
  newValue      Json?
  metadata      Json
  createdAt     DateTime @default(now())
  actor         User?    @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId, createdAt])
}
