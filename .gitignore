# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# local document-ingestion storage (original uploads are runtime data)
/var/imports/
/var/storage-proof/

# local PostgreSQL backups (never version database dumps)
/backups/

# generated product-demo recordings, audio, manifests and reports
/artifacts/video-demo/
*.mp4
*.webm
*.wav
*.mp3
*.m4a
*.aac

# database exports remain local even if created outside the backup folder
*.dump
*.sql
*.sql.gz
!prisma/migrations/**/migration.sql

# next.js
/.next/
/.next-video-demo/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
