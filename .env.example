# Mandatory — local PostgreSQL database used by Prisma and the application.
# Replace CHANGE_ME with a password chosen only for the local development user.
DATABASE_URL="postgresql://joint_procurement_user:CHANGE_ME@localhost:5432/joint_procurement_os?schema=public"

# Optional — Smart Import remains deterministic and local when omitted or set to local.
# No document is sent to an external provider in this mode.
DOCUMENT_INTELLIGENCE_PROVIDER="local"

# Development-only overrides. Normally leave these commented out.
# QA_PORT="3107"
# QA_BASE_URL="http://localhost:3107"

# Video-demo-only overrides. The video scripts provide these defaults internally.
# VIDEO_DEMO_PORT="3117"
# VIDEO_DEMO_BASE_URL="http://localhost:3117"
# VIDEO_DEMO_PACE="1"
# VIDEO_DEMO_MODE="1"

# Optional final-video assembly inputs. Keep these files outside Git.
# VOICEOVER_ZIP_PATH="C:\\path\\to\\joint_procurement_voiceover.zip"
# MUSIC_PATH="C:\\path\\to\\licensed-background-music.mp3"

# Future provider-only credentials are intentionally absent. Add variables only
# when a real, explicitly configured DocumentInterpretationProvider exists.
