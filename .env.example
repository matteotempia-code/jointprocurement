# Mandatory - Supabase transaction pooler used by the application.
DATABASE_URL="postgresql://postgres.PROJECT_REF:CHANGE_ME@POOLER_HOST:6543/postgres?pgbouncer=true"

# Mandatory - Supabase session pooler used only by Prisma migrations.
DIRECT_URL="postgresql://postgres.PROJECT_REF:CHANGE_ME@POOLER_HOST:5432/postgres"

# Required only for the destructive deterministic demo seed. Never enable in production.
SORGENCE_ENVIRONMENT="development"
ALLOW_DEMO_SEED="false"

# Canonical runtime document storage. Keep the elevated key server-side only.
DOCUMENT_STORAGE_PROVIDER="supabase"
DEMO_MODE="false"
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="CHANGE_ME_SERVER_ONLY"
SUPABASE_STORAGE_BUCKET="source-documents"

# Smart Import interpretation remains deterministic and local.
DOCUMENT_INTELLIGENCE_PROVIDER="local"

# Optional server-only procurement intelligence. Never prefix the API key with NEXT_PUBLIC_.
PROCUREMENT_AI_ENABLED="false"
PROCUREMENT_AI_PRIMARY_PROVIDER="openai"
OPENAI_PROCUREMENT_MODEL="gpt-5-mini"
OPENAI_API_KEY="CHANGE_ME_SERVER_ONLY"

# Development-only overrides. Normally leave these commented out.
# QA_PORT="3107"
# QA_BASE_URL="http://localhost:3107"

# Video-demo-only overrides. The video scripts provide these defaults internally.
# VIDEO_DEMO_PORT="3117"
# VIDEO_DEMO_BASE_URL="http://localhost:3117"
# VIDEO_DEMO_PACE="1"
# VIDEO_DEMO_MODE="1"

# Optional final-video assembly inputs. Keep these files outside Git.
# VOICEOVER_ZIP_PATH="C:\\path\\to\\joint_procurement_voiceover.zip"
# MUSIC_PATH="C:\\path\\to\\licensed-background-music.mp3"
